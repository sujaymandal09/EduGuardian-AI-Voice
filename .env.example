# Existing voice configuration
SECRET_KEY=replace-with-a-long-random-value
NGROK_URL=https://your-public-domain.example
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
GROQ_API_KEY=
SCHOOL_NAME=Your School
SCHOOL_PHONE=
SCHOOL_TIMEZONE=Asia/Kolkata

# Amazon RDS PostgreSQL call history
CALL_HISTORY_ENABLED=false
DATABASE_URL=postgresql+psycopg://username:password@rds-hostname:5432/eduguardian?sslmode=require

# Existing calendar configuration
CALENDAR_PROVIDER=google
GOOGLE_SERVICE_ACCOUNT_FILE=
DEFAULT_TEACHER_ID=
MEETING_HOURS_START=09:00
MEETING_HOURS_END=12:00
MEETING_DURATION_MINUTES=30
MEETING_WORKING_DAYS=mon,tue,wed,thu,fri
